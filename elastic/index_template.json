{
  "index_patterns": ["yt-trending*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "1s",
      "index.default_pipeline": "yt-trending-ingest"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "video_id": { "type": "keyword" },
        "title": {
          "type": "text",
          "analyzer": "english",
          "fields": {
            "keyword": { "type": "keyword", "ignore_above": 256 }
          }
        },
        "description": {
          "type": "text",
          "analyzer": "english"
        },
        "tags": { "type": "keyword" },
        "channel_id": { "type": "keyword" },
        "channel_title": {
          "type": "keyword",
          "fields": {
            "text": { "type": "text", "analyzer": "english" }
          }
        },
        "category_id": { "type": "keyword" },
        "category_name": { "type": "keyword" },
        "region": { "type": "keyword" },
        "published_at": { "type": "date" },
        "fetched_at": { "type": "date" },
        "ingested_at": { "type": "date" },
        "duration_sec": { "type": "integer" },
        "views": { "type": "long" },
        "likes": { "type": "long" },
        "comments": { "type": "long" },
        "sentiment": { "type": "float" },
        "sentiment_label": { "type": "keyword" },
        "pagerank": { "type": "float" },
        "betweenness": { "type": "float" },
        "community_id": { "type": "integer" }
      }
    }
  }
}
