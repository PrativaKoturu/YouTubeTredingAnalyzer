# Copy this file to .env and fill in values.
# Never commit a real .env file.

# YouTube Data API v3 key (only needed for live producer)
YOUTUBE_API_KEY=AIzaSyA6GtX9sUeJahmKX_bhq6eCFId4ioqEW14

# Kafka
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_RAW_TOPIC=yt.trending.raw
KAFKA_DEAD_TOPIC=yt.trending.dead
KAFKA_GROUP_ID=yt-trending-consumer

# Elasticsearch
ES_URL=http://localhost:9200
ES_INDEX=yt-trending

# Regions to poll (comma-separated ISO 3166-1 alpha-2)
REGIONS=IN,US,GB

# Producer
POLL_INTERVAL_SEC=300
YOUTUBE_MAX_RESULTS=50

# CSV replay
REPLAY_CSV=data/sample/sample_trending.csv
REPLAY_DELAY_SEC=0.2

# Consumer
BULK_SIZE=200
BLOOM_M_BITS=100000
BLOOM_K_HASHES=5
